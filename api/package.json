{
  "name": "@sivoov/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --env local --port 8788",
    "deploy": "wrangler deploy",
    "deploy:preview": "wrangler deploy --env preview",
    "types": "wrangler types",
    "typecheck": "npm run types && tsc --noEmit",
    "test": "vitest run && vitest run -c vitest.tools.config.ts",
    "lint": "eslint .",
    "db:migrate:local": "wrangler d1 migrations apply sivoov-run --local --env local",
    "db:migrate:preview": "wrangler d1 migrations apply sivoov-run-preview --remote --env preview",
    "db:migrate:production": "wrangler d1 migrations apply sivoov-run --remote",
    "seed": "tsx tools/seed.ts",
    "import:entrants": "tsx tools/import-entrants.ts",
    "audio:build": "tsx tools/audio/build.ts",
    "e2e": "playwright test",
    "trace:pull": "tsx tools/trace-pull.ts"
  },
  "dependencies": {
    "@sivoov/shared": "*",
    "hono": "^4.13.7",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@playwright/test": "^1.63.0",
    "tsx": "^4.23.13",
    "wrangler": "^4.131.1"
  }
}
